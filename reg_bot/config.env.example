# Copy to config.env and fill in values:
#   cp config.env.example config.env
#   chmod 600 config.env

# Required for encrypted wallets (override the script default).
REG_BOT_WALLET_PASSWORD=

# Optional Discord/Slack webhook for registration notifications.
# REG_BOT_WEBHOOK_URL=

# Python interpreter (must have bittensor installed).
REG_BOT_PYTHON=/root/.venv/bin/python3

# Extra CLI args passed to reg_bot.py (quote the whole value when using multiple flags).
REG_BOT_ARGS="--verbose"

# Example with registration options:
# REG_BOT_ARGS="--verbose --max-reg-cost 0.142 --wallet-name honestdragon --hotkeys oro-08 oro-09"
